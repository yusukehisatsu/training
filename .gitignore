# ============================================================
# このリポジトリは GitHub Pages（公開元: /docs）として運用する。
# git 管理対象は /docs・/resource と最小限のメタファイル
# （README.md / CLAUDE.md / .gitignore / .claude/skills/）。
# ============================================================

# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# Claude Code ローカル状態（settings.local.json 等）は除外。
# ただし .claude/skills/ 配下はリポジトリで共有する作業手順のため追跡対象にする。
.claude/*
!.claude/skills/

# resource/ は一次ソースとして git 管理対象。
# GitHub Pages の公開単位はあくまで /docs のため、Pages 上には出ない。

# 一時ファイル / ログ
*.log
*.tmp
